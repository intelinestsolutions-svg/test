          "label": "Position",
          "type": "text"
        },
        {
          "name": "employment_type",
          "label": "Employment Type",
          "type": "select",
          "options": [
            "Full-time",
            "Part-time",
            "Contract",
            "Intern"
          ]
        },
        {
