{
  "id": "email",
  "name": "Email",
  "description": "Send and track emails to customers and staff.",
  "icon": "✉️",
  "version": "1.0.0",
  "resources": [
    {
      "key": "messages",
      "label": "Messages",
      "singular": "Message",
