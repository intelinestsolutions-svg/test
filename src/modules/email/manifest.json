          "required": true
        },
        {
          "name": "status",
          "label": "Status",
          "type": "select",
          "options": ["Draft", "Sent", "Failed"],
          "default": "Draft"
        },
        {
          "name": "sent_at",
          "label": "Sent At",
          "type": "datetime"
