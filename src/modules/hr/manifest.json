        {
          "name": "employee_no",
          "label": "Employee No.",
          "type": "text",
          "required": true,
          "unique": true
        },
        {
          "name": "name",
          "label": "Full Name",
          "type": "text",
          "required": true
        },
        {
          "name": "email",
          "label": "Email",
          "type": "text"
        },
        {
          "name": "phone",
          "label": "Phone",
          "type": "text"
        },
        {
