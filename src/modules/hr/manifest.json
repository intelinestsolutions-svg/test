          "label": "Hire Date",
          "type": "date"
        },
        {
          "name": "basic_salary",
          "label": "Basic Salary",
          "type": "money"
        },
        {
          "name": "status",
          "label": "Status",
          "type": "select",
          "options": [
            "Active",
            "Probation",
            "Resigned",
            "Terminated"
          ],
          "default": "Active"
        },
        {
          "name": "notes",
          "label": "Notes",
          "type": "textarea"
        }
      ]
    },
    {
      "key": "leave_requests",
      "label": "Leave Requests",
      "singular": "Leave Request",
      "fields": [
        {
          "name": "employee",
          "label": "Employee",
          "type": "relation",
          "required": true,
          "relation": {
            "module": "hr",
            "resource": "employees",
            "label": "name"
          }
        },
        {
          "name": "leave_type",
          "label": "Leave Type",
          "type": "select",
          "options": [
            "Annual",
            "Sick",
            "Unpaid",
            "Maternity",
            "Paternity",
            "Emergency"
          ],
          "required": true
        },
        {
          "name": "start_date",
          "label": "Start Date",
          "type": "date",
          "required": true
        },
        {
          "name": "end_date",
          "label": "End Date",
          "type": "date",
          "required": true
        },
        {
          "name": "status",
          "label": "Status",
          "type": "select",
          "options": [
            "Pending",
            "Approved",
            "Rejected",
            "Cancelled"
          ],
          "default": "Pending"
        },
        {
          "name": "reason",
          "label": "Reason",
          "type": "textarea"
        }
      ]
    }
